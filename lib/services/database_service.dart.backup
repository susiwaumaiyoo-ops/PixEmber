import 'dart:async';
import 'dart:isolate';
import 'dart:math';
import 'dart:typed_data';
import 'package:path/path.dart';
import 'package:sqflite/sqflite.dart';
import 'package:path_provider/path_provider.dart';

/// Isolate で使用する類似度計算結果の軽量データクラス
/// Isolate 境界を越えて送受信できるよう、プリミティブ型のみで構成
class _SimilarityResult {
  final int workId;
  final double similarity;

  _SimilarityResult({required this.workId, required this.similarity});
}

class DatabaseService {
  static final DatabaseService _instance = DatabaseService._internal();
  static Database? _database;
  // 並行初期化による sqflite の二重オープン（デッドロックの根源）を排除するためのガード
  static Completer<Database>? _initCompleter;

  factory DatabaseService() {
    return _instance;
  }

  DatabaseService._internal();

  Future<Database> get database async {
    // 並行初期化競合を排除：既に初期化中なら同じ Future を共有して openDatabase の二重実行を防ぐ
    if (_database != null) return _database!;
    if (_initCompleter != null) return _initCompleter!.future;
    _initCompleter = Completer<Database>();
    try {
      _database = await _initDatabase();
      _initCompleter!.complete(_database!);
    } catch (e) {
      _initCompleter!.completeError(e);
      _initCompleter = null; // 失敗時は次回の呼び出しで再試行できるようにリセット
      rethrow;
    }
    return _database!;
  }

  Future<Database> _initDatabase() async {
    final documentsDirectory = await getApplicationDocumentsDirectory();
    final path = join(documentsDirectory.path, 'pixiv_history_local.db');

    return await openDatabase(
      path,
version: 4,
      onCreate: _onCreate,
      onUpgrade: _onUpgrade,
    );
  }

  Future<void> _onUpgrade(Database db, int oldVersion, int newVersion) async {
    // バージョン1からのマイグレーション：オフライン用本文キャッシュテーブルを追加
    if (oldVersion < 2) {
      await db.execute('''
        CREATE TABLE IF NOT EXISTS novel_texts (
          work_id INTEGER PRIMARY KEY,
          title TEXT NOT NULL,
          author_name TEXT NOT NULL,
          text TEXT NOT NULL,
          pages_json TEXT NOT NULL,
          updated_at INTEGER NOT NULL
        )
      ''');
    }
    // バージョン2からのマイグレーション：小説ベクトル（Embedding）テーブルを追加
    if (oldVersion < 3) {
      await db.execute('''
        CREATE TABLE IF NOT EXISTS novel_embeddings (
          work_id INTEGER PRIMARY KEY,
          embedding BLOB NOT NULL, -- Float32List をバイト列として保存
          updated_at INTEGER NOT NULL
        )
      ''');
    }
    // バージョン3からのマイグレーション：ダウンロード済みイラストテーブルを追加
    if (oldVersion < 4) {
      await db.execute('''
        CREATE TABLE IF NOT EXISTS downloaded_illusts (
          work_id INTEGER PRIMARY KEY,
          title TEXT NOT NULL,
          author_name TEXT NOT NULL,
          type TEXT NOT NULL,
          saved_at INTEGER NOT NULL
        )
      ''');
    }
  }

  Future<void> _onCreate(Database db, int version) async {
    // 1. 履歴テーブルの作成
    await db.execute('''
      CREATE TABLE history (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        work_id INTEGER NOT NULL,
        title TEXT NOT NULL,
        author_name TEXT NOT NULL,
        preview_url TEXT NOT NULL,
        type TEXT NOT NULL, -- 'illust' or 'novel'
        viewed_at INTEGER NOT NULL
      )
    ''');
    await db.execute('''
      CREATE UNIQUE INDEX idx_history_work_type ON history (work_id, type)
    ''');

    // 2. ミュート（ブラックリスト）テーブルの作成
    // mute_type: 'tag' (タグ), 'user' (ユーザーID), 'ai' (AI判定: '0'=AI以外, '1'=AI作品, '2'=すべて)
    await db.execute('''
      CREATE TABLE mutes (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        mute_type TEXT NOT NULL,
        value TEXT NOT NULL, -- タグ文字列、ユーザーID文字列、またはAIフラグ
        label TEXT, -- 表示名（ユーザー名やタグ名など）
        created_at INTEGER NOT NULL
      )
    ''');
    await db.execute('''
      CREATE UNIQUE INDEX idx_mutes_type_value ON mutes (mute_type, value)
    ''');

    // 3. お気に入りフォルダテーブルの作成
    await db.execute('''
      CREATE TABLE folders (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL UNIQUE,
        created_at INTEGER NOT NULL
      )
    ''');

    // 4. フォルダ内お気に入りアイテムテーブルの作成
    await db.execute('''
      CREATE TABLE folder_items (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        folder_id INTEGER NOT NULL,
        work_id INTEGER NOT NULL,
        title TEXT NOT NULL,
        author_name TEXT NOT NULL,
        preview_url TEXT NOT NULL,
        type TEXT NOT NULL, -- 'illust' or 'novel'
        added_at INTEGER NOT NULL,
        FOREIGN KEY (folder_id) REFERENCES folders(id) ON DELETE CASCADE
      )
    ''');
    await db.execute('''
      CREATE UNIQUE INDEX idx_folder_items_unique ON folder_items (folder_id, work_id, type)
    ''');

    // 5. 購読タグ管理テーブルの作成
    await db.execute('''
      CREATE TABLE subscribed_tags (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        tag_name TEXT NOT NULL,
        type TEXT NOT NULL, -- 'illust' or 'novel'
        last_synced_at INTEGER, -- 最終同期エポック秒
        latest_work_id INTEGER, -- 最後に検知した最新作品のID（新着検知用）
        created_at INTEGER NOT NULL
      )
    ''');
    await db.execute('''
      CREATE UNIQUE INDEX idx_subscribed_tags_unique ON subscribed_tags (tag_name, type)
    ''');

    // 6. オフライン用小説本文キャッシュテーブル
    await db.execute('''
      CREATE TABLE IF NOT EXISTS novel_texts (
        work_id INTEGER PRIMARY KEY,
        title TEXT NOT NULL,
        author_name TEXT NOT NULL,
        text TEXT NOT NULL,
        pages_json TEXT NOT NULL,
        updated_at INTEGER NOT NULL
      )
    ''');

    // 7. 小説ベクトル（Embedding）テーブル
    await db.execute('''
      CREATE TABLE IF NOT EXISTS novel_embeddings (
        work_id INTEGER PRIMARY KEY,
        embedding BLOB NOT NULL, -- Float32List をバイト列として保存
        updated_at INTEGER NOT NULL
      )
    ''');

    // 8. ダウンロード済みイラストテーブル
    await db.execute('''
      CREATE TABLE IF NOT EXISTS downloaded_illusts (
        work_id INTEGER PRIMARY KEY,
        title TEXT NOT NULL,
        author_name TEXT NOT NULL,
        type TEXT NOT NULL,
        saved_at INTEGER NOT NULL
      )
    ''');
  }

  // ==========================================
  // 1. HISTORY (閲覧履歴) CRUD
  // ==========================================

  Future<int> insertOrUpdateHistory({
    required int workId,
    required String title,
    required String authorName,
    required String previewUrl,
    required String type,
  }) async {
    final db = await database;
    final now = DateTime.now().millisecondsSinceEpoch ~/ 1000;

    // トランザクションを使わず、シンプルな単一 INSERT + conflictAlgorithm で UPSERT。
    // これにより sqflite のデッドロックを 100% 回避する。
    return await db.insert('history', {
      'work_id': workId,
      'title': title,
      'author_name': authorName,
      'preview_url': previewUrl,
      'type': type,
      'viewed_at': now,
    }, conflictAlgorithm: ConflictAlgorithm.replace);
  }

  Future<List<Map<String, dynamic>>> getHistoryList({
    String? type, // 'illust' or 'novel'
    int limit = 50,
    int offset = 0,
  }) async {
    final db = await database;
    if (type != null) {
      return await db.query(
        'history',
        where: 'type = ?',
        whereArgs: [type],
        orderBy: 'viewed_at DESC',
        limit: limit,
        offset: offset,
      );
    } else {
      return await db.query(
        'history',
        orderBy: 'viewed_at DESC',
        limit: limit,
        offset: offset,
      );
    }
  }

  /// 履歴をキーワード検索・タイプ絞り込みで取得
  Future<List<Map<String, dynamic>>> searchHistory({
    required String query,
    String? type, // 'illust' or 'novel'
    int limit = 50,
    int offset = 0,
  }) async {
    final db = await database;
    final searchQuery = '%$query%';

    if (type != null) {
      return await db.query(
        'history',
        where: 'type = ? AND (title LIKE ? OR author_name LIKE ?)',
        whereArgs: [type, searchQuery, searchQuery],
        orderBy: 'viewed_at DESC',
        limit: limit,
        offset: offset,
      );
    } else {
      return await db.query(
        'history',
        where: 'title LIKE ? OR author_name LIKE ?',
        whereArgs: [searchQuery, searchQuery],
        orderBy: 'viewed_at DESC',
        limit: limit,
        offset: offset,
      );
    }
  }

  Future<int> clearHistory() async {
    final db = await database;
    return await db.delete('history');
  }

  Future<int> deleteHistoryItem(int workId, String type) async {
    final db = await database;
    return await db.delete(
      'history',
      where: 'work_id = ? AND type = ?',
      whereArgs: [workId, type],
    );
  }

  // ==========================================
  // 2. MUTES (ミュート / ブラックリスト) CRUD
  // ==========================================

  Future<int> insertOrUpdateMute({
    required String muteType, // 'tag', 'user', 'ai'
    required String value,
    String? label,
  }) async {
    final db = await database;
    final now = DateTime.now().millisecondsSinceEpoch ~/ 1000;

    // トランザクション不使用の単一 INSERT + conflictAlgorithm で UPSERT。
    return await db.insert('mutes', {
      'mute_type': muteType,
      'value': value,
      'label': label,
      'created_at': now,
    }, conflictAlgorithm: ConflictAlgorithm.replace);
  }

  Future<List<Map<String, dynamic>>> getMutesList() async {
    final db = await database;
    return await db.query('mutes', orderBy: 'created_at DESC');
  }

  Future<int> deleteMute(int id) async {
    final db = await database;
    return await db.delete('mutes', where: 'id = ?', whereArgs: [id]);
  }

  Future<int> deleteMuteByValue(String muteType, String value) async {
    final db = await database;
    return await db.delete(
      'mutes',
      where: 'mute_type = ? AND value = ?',
      whereArgs: [muteType, value],
    );
  }

  // ==========================================
  // 3. FOLDERS (お気に入りフォルダ) CRUD
  // ==========================================

  Future<int> createFolder(String name) async {
    final db = await database;
    final now = DateTime.now().millisecondsSinceEpoch ~/ 1000;
    return await db.insert('folders', {'name': name, 'created_at': now});
  }

  Future<List<Map<String, dynamic>>> getFoldersList() async {
    final db = await database;
    return await db.query('folders', orderBy: 'created_at DESC');
  }

  Future<int> deleteFolder(int id) async {
    final db = await database;
    // Cascade delete manually since foreign keys support in sqflite needs "PRAGMA foreign_keys = ON"
    await db.delete('folder_items', where: 'folder_id = ?', whereArgs: [id]);
    return await db.delete('folders', where: 'id = ?', whereArgs: [id]);
  }

  Future<int> renameFolder(int id, String newName) async {
    final db = await database;
    return await db.update(
      'folders',
      {'name': newName},
      where: 'id = ?',
      whereArgs: [id],
    );
  }

  // ==========================================
  // 4. FOLDER ITEMS (お気に入りアイテム) CRUD
  // ==========================================

  Future<int> addFolderItem({
    required int folderId,
    required int workId,
    required String title,
    required String authorName,
    required String previewUrl,
    required String type, // 'illust' or 'novel'
  }) async {
    final db = await database;
    final now = DateTime.now().millisecondsSinceEpoch ~/ 1000;

    // トランザクション不使用の単一 INSERT + conflictAlgorithm で UPSERT。
    return await db.insert('folder_items', {
      'folder_id': folderId,
      'work_id': workId,
      'title': title,
      'author_name': authorName,
      'preview_url': previewUrl,
      'type': type,
      'added_at': now,
    }, conflictAlgorithm: ConflictAlgorithm.replace);
  }

  Future<List<Map<String, dynamic>>> getFolderItems({
    required int folderId,
    String? type,
    int limit = 50,
    int offset = 0,
  }) async {
    final db = await database;
    if (type != null) {
      return await db.query(
        'folder_items',
        where: 'folder_id = ? AND type = ?',
        whereArgs: [folderId, type],
        orderBy: 'added_at DESC',
        limit: limit,
        offset: offset,
      );
    } else {
      return await db.query(
        'folder_items',
        where: 'folder_id = ?',
        whereArgs: [folderId],
        orderBy: 'added_at DESC',
        limit: limit,
        offset: offset,
      );
    }
  }

  Future<int> removeFolderItem({
    required int folderId,
    required int workId,
    required String type,
  }) async {
    final db = await database;
    return await db.delete(
      'folder_items',
      where: 'folder_id = ? AND work_id = ? AND type = ?',
      whereArgs: [folderId, workId, type],
    );
  }

  Future<bool> isWorkInFolder(int workId, String type) async {
    final db = await database;
    final res = await db.query(
      'folder_items',
      columns: ['id'],
      where: 'work_id = ? AND type = ?',
      whereArgs: [workId, type],
      limit: 1,
    );
    return res.isNotEmpty;
  }

  // ==========================================
  // 5. SUBSCRIBED TAGS (購読タグ) CRUD
  // ==========================================

  Future<int> addSubscribedTag(String tagName, String type) async {
    final db = await database;
    final now = DateTime.now().millisecondsSinceEpoch ~/ 1000;

    // トランザクション不使用の単一 INSERT。重複時は何もしない（ignore）。
    return await db.insert('subscribed_tags', {
      'tag_name': tagName,
      'type': type,
      'created_at': now,
    }, conflictAlgorithm: ConflictAlgorithm.ignore);
  }

  Future<List<Map<String, dynamic>>> getSubscribedTagsList({
    String? type,
  }) async {
    final db = await database;
    if (type != null) {
      return await db.query(
        'subscribed_tags',
        where: 'type = ?',
        whereArgs: [type],
        orderBy: 'created_at DESC',
      );
    } else {
      return await db.query('subscribed_tags', orderBy: 'created_at DESC');
    }
  }

  Future<int> deleteSubscribedTag(int id) async {
    final db = await database;
    return await db.delete('subscribed_tags', where: 'id = ?', whereArgs: [id]);
  }

  Future<int> deleteSubscribedTagByName(String tagName, String type) async {
    final db = await database;
    return await db.delete(
      'subscribed_tags',
      where: 'tag_name = ? AND type = ?',
      whereArgs: [tagName, type],
    );
  }

  Future<int> updateSubscriptionSyncState(
    int id, {
    required int lastSyncedAt,
    required int latestWorkId,
  }) async {
    final db = await database;
    return await db.update(
      'subscribed_tags',
      {'last_synced_at': lastSyncedAt, 'latest_work_id': latestWorkId},
      where: 'id = ?',
      whereArgs: [id],
    );
  }

  /// DBインスタンスを再起動（復元後のリフレッシュ用）
  Future<void> restartDatabase() async {
    if (_database != null) {
      await _database!.close();
      _database = null;
    }
  }

  // ==========================================
  // 6. NOVEL TEXTS (オフライン用本文キャッシュ) CRUD
  // ==========================================

  /// 小説本文をローカルにキャッシュ（UPSERT）。pagesJson は List<String> を
  /// JSON エンコードした文字列を渡す。
  Future<int> saveNovelText({
    required int workId,
    required String title,
    required String authorName,
    required String text,
    required String pagesJson,
  }) async {
    final db = await database;
    final now = DateTime.now().millisecondsSinceEpoch ~/ 1000;
    return await db.insert('novel_texts', {
      'work_id': workId,
      'title': title,
      'author_name': authorName,
      'text': text,
      'pages_json': pagesJson,
      'updated_at': now,
    }, conflictAlgorithm: ConflictAlgorithm.replace);
  }

  /// キャッシュされた小説本文を取得。未キャッシュなら null。
  Future<Map<String, dynamic>?> getNovelText(int workId) async {
    final db = await database;
    final res = await db.query(
      'novel_texts',
      where: 'work_id = ?',
      whereArgs: [workId],
      limit: 1,
    );
    return res.isNotEmpty ? res.first : null;
  }

  // ==========================================
  // 7. NOVEL EMBEDDINGS (小説ベクトル/Embedding) CRUD
  // ==========================================

  /// 小説のベクトル（Embedding）を保存（UPSERT）
  /// embedding は Float32List（384次元想定）を渡す
  Future<int> saveNovelEmbedding({
    required int workId,
    required Float32List embedding,
  }) async {
    final db = await database;
    final now = DateTime.now().millisecondsSinceEpoch ~/ 1000;
    // Float32List をバイト列に変換して保存
    final bytes = embedding.buffer.asUint8List();
    return await db.insert('novel_embeddings', {
      'work_id': workId,
      'embedding': bytes,
      'updated_at': now,
    }, conflictAlgorithm: ConflictAlgorithm.replace);
  }

  /// 保存された小説ベクトルを取得。未保存なら null。
  Future<Float32List?> getNovelEmbedding(int workId) async {
    final db = await database;
    final res = await db.query(
      'novel_embeddings',
      where: 'work_id = ?',
      whereArgs: [workId],
      limit: 1,
    );
    if (res.isEmpty) return null;
    final bytes = res.first['embedding'] as Uint8List;
    return Float32List.fromList(bytes.buffer.asFloat32List());
  }

  // ==========================================
  // 8. DOWNLOADED ILLUSTS (ダウンロード済み作品) CRUD
  // ==========================================

  /// ダウンロード済みイラストを保存（UPSERT）
  Future<int> insertDownloadedIllust({
    required int workId,
    required String title,
    required String authorName,
    required String type,
  }) async {
    final db = await database;
    final now = DateTime.now().millisecondsSinceEpoch ~/ 1000;
    return await db.insert('downloaded_illusts', {
      'work_id': workId,
      'title': title,
      'author_name': authorName,
      'type': type,
      'saved_at': now,
    }, conflictAlgorithm: ConflictAlgorithm.replace);
  }

  /// ダウンロード済みイラスト一覧を取得
  Future<List<Map<String, dynamic>>> getDownloadedIllustsList() async {
    final db = await database;
    return await db.query(
      'downloaded_illusts',
      orderBy: 'saved_at DESC',
    );
  }

  /// ダウンロード済みイラストを削除
  Future<int> deleteDownloadedIllust(int workId) async {
    final db = await database;
    return await db.delete(
      'downloaded_illusts',
      where: 'work_id = ?',
      whereArgs: [workId],
    );
  }

/// コサイン類似度で類似小説を検索
  /// userEmbedding: 検索クエリのベクトル
  /// limit: 取得件数上限
  /// minSimilarity: 最小類似度閾値（0.0〜1.0）
  Future<List<Map<String, dynamic>>> searchNovelsByEmbedding({
    required Float32List userEmbedding,
    int limit = 20,
    double minSimilarity = 0.0,
  }) async {
    final db = await database;
    // 全ベクトルを取得（インデックスがないためフルスキャン。件数が多い場合は最適化必要）
    final allEmbeddings = await db.query('novel_embeddings');

    if (allEmbeddings.isEmpty) return [];

    // 重いコサイン類似度計算を Isolate で実行（メインスレッドをブロックしない）
    final topWorkIds = await Isolate.run(() => _computeTopSimilarities(
          userEmbedding: userEmbedding,
          allEmbeddings: allEmbeddings,
          minSimilarity: minSimilarity,
          limit: limit,
        ));

    if (topWorkIds.isEmpty) return [];

    // 上位作品の詳細情報を取得
    final results = <Map<String, dynamic>>[];
    for (final workId in topWorkIds) {
      final novelInfo = await db.query(
        'novel_texts',
        where: 'work_id = ?',
        whereArgs: [workId],
        limit: 1,
      );

      if (novelInfo.isNotEmpty) {
        // 類似度も再取得するため、計算結果から探す
        final similarity = await _getSimilarityForWorkId(workId, userEmbedding);
        if (similarity != null) {
          results.add({
            'work_id': workId,
            'title': novelInfo.first['title'],
            'author_name': novelInfo.first['author_name'],
            'similarity': similarity,
          });
        }
      }
    }

    // 類似度降順でソート（念のため）
    results.sort(
      (a, b) =>
          (b['similarity'] as double).compareTo(a['similarity'] as double),
    );

    return results.take(limit).toList();
  }

  /// Isolate で実行される重いコサイン類似度計算
  /// 上位 limit 件の work_id を類似度降順で返す
  static List<int> _computeTopSimilarities({
    required Float32List userEmbedding,
    required List<Map<String, dynamic>> allEmbeddings,
    required double minSimilarity,
    required int limit,
  }) {
    final userNorm = _vectorNormStatic(userEmbedding);
    final similarities = <_SimilarityResult>[];

    for (final row in allEmbeddings) {
      final workId = row['work_id'] as int;
      final bytes = row['embedding'] as Uint8List;
      final embedding = Float32List.fromList(bytes.buffer.asFloat32List());

      // 次元数が合わない場合はスキップ
      if (embedding.length != userEmbedding.length) continue;

      final similarity = _cosineSimilarityStatic(userEmbedding, embedding, userNorm);

      if (similarity >= minSimilarity) {
        similarities.add(_SimilarityResult(workId: workId, similarity: similarity));
      }
    }

    // 類似度降順でソート
    similarities.sort((a, b) => b.similarity.compareTo(a.similarity));

    // 上位 limit 件の work_id を返す
    return similarities.take(limit).map((r) => r.workId).toList();
  }

  /// 特定の workId の類似度を取得（メインスレッド用、少数なので高速）
  Future<double?> _getSimilarityForWorkId(int workId, Float32List userEmbedding) async {
    final db = await database;
    final row = await db.query(
      'novel_embeddings',
      where: 'work_id = ?',
      whereArgs: [workId],
      limit: 1,
    );
    if (row.isEmpty) return null;
    final bytes = row.first['embedding'] as Uint8List;
    final embedding = Float32List.fromList(bytes.buffer.asFloat32List());
    if (embedding.length != userEmbedding.length) return null;
    final userNorm = _vectorNorm(userEmbedding);
    return _cosineSimilarity(userEmbedding, embedding, userNorm);
  }

  /// Isolate で使用するための静的メソッド（インスタンスメソッドは Isolate で使えない）
  static double _vectorNormStatic(Float32List vec) {
    double sum = 0.0;
    for (final v in vec) {
      sum += v * v;
    }
    return sqrt(sum);
  }

static double _cosineSimilarityStatic(Float32List a, Float32List b, double aNorm) {
    double dot = 0.0;
    for (int i = 0; i < a.length; i++) {
      dot += a[i] * b[i];
    }
    final bNorm = _vectorNormStatic(b);
    if (aNorm == 0.0 || bNorm == 0.0) return 0.0;
    return dot / (aNorm * bNorm);
  }

  /// ベクトルのノルム（長さ）を計算
  double _vectorNorm(Float32List vec) {
    double sum = 0.0;
    for (final v in vec) {
      sum += v * v;
    }
    return sqrt(sum);
  }

  /// コサイン類似度を計算（事前計算済みの userNorm を使用して高速化）
  double _cosineSimilarity(Float32List a, Float32List b, double aNorm) {
    double dot = 0.0;
    for (int i = 0; i < a.length; i++) {
      dot += a[i] * b[i];
    }
    final bNorm = _vectorNorm(b);
    if (aNorm == 0.0 || bNorm == 0.0) return 0.0;
    return dot / (aNorm * bNorm);
  }

/// 全データをエクスポート（JSONバックアップ用）
  Future<Map<String, dynamic>> exportAllData() async {
    final db = await database;

    final history = await db.query('history', orderBy: 'viewed_at DESC');
    final mutes = await db.query('mutes', orderBy: 'created_at DESC');
    final folders = await db.query('folders', orderBy: 'created_at DESC');
    final folderItems = await db.query(
      'folder_items',
      orderBy: 'added_at DESC',
    );
    final subscribedTags = await db.query(
      'subscribed_tags',
      orderBy: 'created_at DESC',
    );
    final novelTexts = await db.query(
      'novel_texts',
      orderBy: 'updated_at DESC',
    );
    final novelEmbeddings = await db.query(
      'novel_embeddings',
      orderBy: 'updated_at DESC',
    );

    return {
      'version': 1,
      'exported_at': DateTime.now().millisecondsSinceEpoch ~/ 1000,
      'history': history,
      'mutes': mutes,
      'folders': folders,
      'folder_items': folderItems,
      'subscribed_tags': subscribedTags,
      'novel_texts': novelTexts,
      'novel_embeddings': novelEmbeddings,
    };
  }

  /// JSONデータからインポート（マージロジック付き）
  /// 戻り値: 追加/更新されたレコード数のサマリー
  Future<Map<String, int>> importAllData(Map<String, dynamic> jsonData) async {
    final db = await database;
final summary = <String, int>{
      'history_added': 0,
      'history_updated': 0,
      'mutes_added': 0,
      'mutes_updated': 0,
      'folders_added': 0,
      'folders_updated': 0,
      'folder_items_added': 0,
      'folder_items_updated': 0,
      'subscribed_tags_added': 0,
      'subscribed_tags_updated': 0,
      'novel_texts_added': 0,
      'novel_texts_updated': 0,
      'novel_embeddings_added': 0,
      'novel_embeddings_updated': 0,
    };

    await db.transaction((txn) async {
      // 1. History - work_id + type で UPSERT
      if (jsonData['history'] != null) {
        for (final item in jsonData['history'] as List) {
          final existing = await txn.query(
            'history',
            where: 'work_id = ? AND type = ?',
            whereArgs: [item['work_id'], item['type']],
            limit: 1,
          );

          if (existing.isEmpty) {
            await txn.insert(
              'history',
              item,
              conflictAlgorithm: ConflictAlgorithm.replace,
            );
            summary['history_added'] = summary['history_added']! + 1;
          } else {
            // viewed_at が新しい方を採用
            final existingViewedAt = existing.first['viewed_at'] as int;
            final newViewedAt = item['viewed_at'] as int;
            if (newViewedAt > existingViewedAt) {
              await txn.update(
                'history',
                item,
                where: 'work_id = ? AND type = ?',
                whereArgs: [item['work_id'], item['type']],
              );
              summary['history_updated'] = summary['history_updated']! + 1;
            }
          }
        }
      }

      // 2. Mutes - mute_type + value で UPSERT
      if (jsonData['mutes'] != null) {
        for (final item in jsonData['mutes'] as List) {
          final existing = await txn.query(
            'mutes',
            where: 'mute_type = ? AND value = ?',
            whereArgs: [item['mute_type'], item['value']],
            limit: 1,
          );

          if (existing.isEmpty) {
            await txn.insert(
              'mutes',
              item,
              conflictAlgorithm: ConflictAlgorithm.replace,
            );
            summary['mutes_added'] = summary['mutes_added']! + 1;
          } else {
            // created_at が新しい方を採用（labelなども更新）
            final existingCreatedAt = existing.first['created_at'] as int;
            final newCreatedAt = item['created_at'] as int;
            if (newCreatedAt >= existingCreatedAt) {
              await txn.update(
                'mutes',
                item,
                where: 'mute_type = ? AND value = ?',
                whereArgs: [item['mute_type'], item['value']],
              );
              summary['mutes_updated'] = summary['mutes_updated']! + 1;
            }
          }
        }
      }

      // 3. Folders - name で UPSERT（フォルダ名はユニーク）
      final folderIdMap = <int, int>{}; // old_id -> new_id
      if (jsonData['folders'] != null) {
        for (final item in jsonData['folders'] as List) {
          final oldId = item['id'] as int;
          final name = item['name'] as String;

          final existing = await txn.query(
            'folders',
            where: 'name = ?',
            whereArgs: [name],
            limit: 1,
          );

          int newId;
          if (existing.isEmpty) {
            // 新規作成
            final result = await txn.insert('folders', {
              'name': name,
              'created_at': item['created_at'],
            }, conflictAlgorithm: ConflictAlgorithm.replace);
            newId = result;
            summary['folders_added'] = summary['folders_added']! + 1;
          } else {
            newId = existing.first['id'] as int;
            // created_at が古い方を採用（元の作成日を保持）
            final existingCreatedAt = existing.first['created_at'] as int;
            final newCreatedAt = item['created_at'] as int;
            if (newCreatedAt < existingCreatedAt) {
              await txn.update(
                'folders',
                {'created_at': newCreatedAt},
                where: 'id = ?',
                whereArgs: [newId],
              );
            }
            summary['folders_updated'] = summary['folders_updated']! + 1;
          }
          folderIdMap[oldId] = newId;
        }
      }

      // 4. Folder Items - folder_id(マッピング後) + work_id + type で UPSERT
      if (jsonData['folder_items'] != null) {
        for (final item in jsonData['folder_items'] as List) {
          final oldFolderId = item['folder_id'] as int;
          final newFolderId = folderIdMap[oldFolderId];

          if (newFolderId == null) continue; // フォルダがマッピングできない場合はスキップ

          final itemData = Map<String, dynamic>.from(item);
          itemData['folder_id'] = newFolderId;
          itemData.remove('id'); // idは自動採番

          final existing = await txn.query(
            'folder_items',
            where: 'folder_id = ? AND work_id = ? AND type = ?',
            whereArgs: [newFolderId, item['work_id'], item['type']],
            limit: 1,
          );

          if (existing.isEmpty) {
            await txn.insert(
              'folder_items',
              itemData,
              conflictAlgorithm: ConflictAlgorithm.replace,
            );
            summary['folder_items_added'] = summary['folder_items_added']! + 1;
          } else {
            // added_at が新しい方を採用
            final existingAddedAt = existing.first['added_at'] as int;
            final newAddedAt = item['added_at'] as int;
            if (newAddedAt > existingAddedAt) {
              await txn.update(
                'folder_items',
                itemData,
                where: 'folder_id = ? AND work_id = ? AND type = ?',
                whereArgs: [newFolderId, item['work_id'], item['type']],
              );
              summary['folder_items_updated'] =
                  summary['folder_items_updated']! + 1;
            }
          }
        }
      }

      // 5. Subscribed Tags - tag_name + type で UPSERT
      if (jsonData['subscribed_tags'] != null) {
        for (final item in jsonData['subscribed_tags'] as List) {
          final existing = await txn.query(
            'subscribed_tags',
            where: 'tag_name = ? AND type = ?',
            whereArgs: [item['tag_name'], item['type']],
            limit: 1,
          );

          if (existing.isEmpty) {
            await txn.insert(
              'subscribed_tags',
              item,
              conflictAlgorithm: ConflictAlgorithm.replace,
            );
            summary['subscribed_tags_added'] =
                summary['subscribed_tags_added']! + 1;
          } else {
            // last_synced_at と latest_work_id は新しい方を採用
            final existingSynced =
                existing.first['last_synced_at'] as int? ?? 0;
            final newSynced = item['last_synced_at'] as int? ?? 0;
            final existingLatest =
                existing.first['latest_work_id'] as int? ?? 0;
            final newLatest = item['latest_work_id'] as int? ?? 0;

            if (newSynced > existingSynced || newLatest > existingLatest) {
              await txn.update(
                'subscribed_tags',
                item,
                where: 'tag_name = ? AND type = ?',
                whereArgs: [item['tag_name'], item['type']],
              );
              summary['subscribed_tags_updated'] =
                  summary['subscribed_tags_updated']! + 1;
            }
          }
        }
      }

      // 6. Novel Texts - work_id で UPSERT
      if (jsonData['novel_texts'] != null) {
        for (final item in jsonData['novel_texts'] as List) {
          final existing = await txn.query(
            'novel_texts',
            where: 'work_id = ?',
            whereArgs: [item['work_id']],
            limit: 1,
          );

          if (existing.isEmpty) {
            await txn.insert(
              'novel_texts',
              item,
              conflictAlgorithm: ConflictAlgorithm.replace,
            );
            summary['novel_texts_added'] = summary['novel_texts_added']! + 1;
} else {
            // updated_at が新しい方を採用
            final existingUpdatedAt = existing.first['updated_at'] as int;
            final newUpdatedAt = item['updated_at'] as int;
            if (newUpdatedAt > existingUpdatedAt) {
              await txn.update(
                'novel_texts',
                item,
                where: 'work_id = ?',
                whereArgs: [item['work_id']],
              );
              summary['novel_texts_updated'] =
                  summary['novel_texts_updated']! + 1;
            }
          }
        }
      }

      // 7. Novel Embeddings - work_id で UPSERT
      if (jsonData['novel_embeddings'] != null) {
        for (final item in jsonData['novel_embeddings'] as List) {
          final existing = await txn.query(
            'novel_embeddings',
            where: 'work_id = ?',
            whereArgs: [item['work_id']],
            limit: 1,
          );

          if (existing.isEmpty) {
            await txn.insert(
              'novel_embeddings',
              item,
              conflictAlgorithm: ConflictAlgorithm.replace,
            );
            summary['novel_embeddings_added'] =
                summary['novel_embeddings_added']! + 1;
          } else {
            // updated_at が新しい方を採用
            final existingUpdatedAt = existing.first['updated_at'] as int;
            final newUpdatedAt = item['updated_at'] as int;
            if (newUpdatedAt > existingUpdatedAt) {
              await txn.update(
                'novel_embeddings',
                item,
                where: 'work_id = ?',
                whereArgs: [item['work_id']],
              );
              summary['novel_embeddings_updated'] =
                  summary['novel_embeddings_updated']! + 1;
            }
          }
        }
      }
    });

    return summary;
  }
}
